<UserControl x:Class="AudioController.App.Controls.EffectsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AudioController.App.Controls"
             Focusable="False">
    <!-- DataContext: EffectsViewModel. FXSound-style: power, preset, live spectrum, five effects, graphic EQ. -->
    <UserControl.Resources>
        <!-- Round power button: green when the effects are on. -->
        <Style x:Key="PowerToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" CornerRadius="16" BorderThickness="1.5" Background="{StaticResource ControlBg}"
                                BorderBrush="{StaticResource BorderStrong}">
                            <TextBlock x:Name="Glyph" Text="&#xE7E8;" Style="{StaticResource IconText}" FontSize="15"
                                       HorizontalAlignment="Center" Foreground="{StaticResource TextFaint}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF173A2A" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Success}" />
                                <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource Success}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The preset list: a thin line (not selectable) between built-in and user presets. -->
        <Style x:Key="PresetItemStyle" TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border Height="1" Margin="6,4" Background="{StaticResource BorderStrong}" />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HzBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Padding" Value="1,1" />
            <Setter Property="Width" Value="46" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasFrequencyError}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Warning}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource Panel}" Padding="12,8,12,8" AutomationProperties.Name="Effects">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ======================== header: power, preset, preset actions, EQ switches -->
            <DockPanel Grid.Row="0" LastChildFill="False">
                <ToggleButton x:Name="PowerButton" DockPanel.Dock="Left" Style="{StaticResource PowerToggle}" IsChecked="{Binding FxEnabled}"
                              AutomationProperties.Name="Effects power"
                              ToolTip="Power: all effects and the EQ on or off — on your headset (Equalizer APO) and on soundboard sounds" />
                <TextBlock DockPanel.Dock="Left" Text="Effects" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,14,0" />

                <Grid DockPanel.Dock="Left" Width="200" VerticalAlignment="Center">
                    <ComboBox x:Name="PresetBox" ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}"
                              DisplayMemberPath="Name" ItemContainerStyle="{StaticResource PresetItemStyle}"
                              AutomationProperties.Name="Preset" MaxDropDownHeight="420"
                              ToolTip="Presets: built-in ones, then yours. Picking one loads its EQ and effects." />
                    <TextBlock Text="Custom" Foreground="{StaticResource TextDim}" Margin="10,0,28,0" VerticalAlignment="Center"
                               IsHitTestVisible="False" Visibility="{Binding IsCustom, Converter={StaticResource BoolToVis}}" />
                </Grid>
                <Border DockPanel.Dock="Left" Style="{StaticResource Badge}" Margin="8,0,0,0" Background="#FF2E2614"
                        Visibility="{Binding IsPresetModified, Converter={StaticResource BoolToVis}}"
                        ToolTip="{Binding PresetDisplayName}">
                    <TextBlock Text="modified" FontSize="10" Foreground="{StaticResource Warning}" />
                </Border>
                <Button DockPanel.Dock="Left" Content="Save as…" Style="{StaticResource SmallButton}" Margin="10,0,0,0" Padding="10,3"
                        Command="{Binding SaveAsCommand}" AutomationProperties.Name="Save preset as"
                        ToolTip="Save the current EQ and effects as your own preset" />
                <Button DockPanel.Dock="Left" Content="Delete" Style="{StaticResource SmallButton}" Margin="6,0,0,0" Padding="10,3"
                        Command="{Binding DeletePresetCommand}" AutomationProperties.Name="Delete preset"
                        ToolTip="Delete the selected preset (only your own; built-in presets stay)" />
                <Button DockPanel.Dock="Left" Content="Reset to Flat" Style="{StaticResource SmallButton}" Margin="6,0,0,0" Padding="10,3"
                        Command="{Binding ResetFlatCommand}" AutomationProperties.Name="Reset to Flat"
                        ToolTip="Every EQ band to 0 dB and every effect to 0 % (band frequencies and switches are kept)" />

                <CheckBox DockPanel.Dock="Right" Content="⅓-octave (31 bands)" IsChecked="{Binding IsThirdOctave}" VerticalAlignment="Center"
                          Margin="14,0,0,0" AutomationProperties.Name="Third-octave EQ"
                          ToolTip="31 fixed third-octave bands (ISO 20 Hz … 20 kHz, Q 4.32) instead of the 10 adjustable bands" />
                <CheckBox DockPanel.Dock="Right" Content="EQ" IsChecked="{Binding EqEnabled}" VerticalAlignment="Center"
                          AutomationProperties.Name="EQ on"
                          ToolTip="The graphic EQ's own switch (the effects follow the power button)" />
            </DockPanel>

            <!-- ======================== inline "Save as…" -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="42,8,0,0"
                        Visibility="{Binding IsSavingPreset, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Preset name" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox x:Name="PresetNameBox" Width="220" MaxLength="40" Text="{Binding NewPresetName, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Preset name" KeyDown="PresetNameBox_KeyDown"
                         IsVisibleChanged="PresetNameBox_IsVisibleChanged" />
                <Button Content="Save" Style="{StaticResource AccentButton}" Margin="8,0,0,0" Padding="14,3"
                        Command="{Binding ConfirmSaveCommand}" AutomationProperties.Name="Save preset" />
                <Button Content="Cancel" Style="{StaticResource SmallButton}" Margin="6,0,0,0" Padding="10,3"
                        Command="{Binding CancelSaveCommand}" />
                <TextBlock Text="{Binding PresetError}" Foreground="{StaticResource Warning}" VerticalAlignment="Center" Margin="10,0,0,0"
                           Visibility="{Binding PresetError, Converter={StaticResource NullToVis}}" />
            </StackPanel>

            <!-- ======================== body: effects (left), spectrum + EQ (right) -->
            <Grid Grid.Row="2" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ItemsControl ItemsSource="{Binding EffectSliders}" Focusable="False" IsEnabled="{Binding FxEnabled}"
                              VerticalAlignment="Center" AutomationProperties.Name="Effect sliders">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2" ToolTip="{Binding Tooltip}" Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="104" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="44" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                <Slider Grid.Column="1" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" TickFrequency="1"
                                        IsSnapToTickEnabled="True" Value="{Binding Value, Mode=TwoWay}" VerticalAlignment="Center"
                                        AutomationProperties.Name="{Binding Label}" />
                                <TextBlock Grid.Column="2" Text="{Binding PercentText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextDim}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border x:Name="SpectrumFrame" Background="#FF101216" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="4" Padding="4,3" AutomationProperties.Name="Spectrum">
                        <controls:SpectrumView x:Name="Spectrum" />
                    </Border>

                    <Grid Grid.Row="1" Margin="0,6,0,0" IsEnabled="{Binding FxEnabled}">
                        <!-- 10 adjustable bands -->
                        <ItemsControl ItemsSource="{Binding TenBands}" Focusable="False" IsEnabled="{Binding EqEnabled}"
                                      Visibility="{Binding IsTenBand, Converter={StaticResource BoolToVis}}"
                                      AutomationProperties.Name="10-band EQ">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel HorizontalAlignment="Center" Margin="2,0">
                                        <TextBlock Text="{Binding GainText}" HorizontalAlignment="Center" FontSize="10" Foreground="{StaticResource TextDim}" />
                                        <Slider Orientation="Vertical" Minimum="-24" Maximum="24" Height="78" Margin="0,3"
                                                TickFrequency="0.5" IsSnapToTickEnabled="True" SmallChange="0.5" LargeChange="3"
                                                HorizontalAlignment="Center" Value="{Binding Gain, Mode=TwoWay}" ToolTip="{Binding Tooltip}"
                                                AutomationProperties.Name="{Binding Label}" />
                                        <TextBox Style="{StaticResource HzBox}" Text="{Binding FrequencyText, UpdateSourceTrigger=LostFocus}"
                                                 ToolTip="{Binding FrequencyTooltip}" KeyDown="HzBox_KeyDown"
                                                 AutomationProperties.Name="Band frequency in hertz" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 31 fixed third-octave bands -->
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" IsEnabled="{Binding EqEnabled}"
                                      Visibility="{Binding IsThirdOctave, Converter={StaticResource BoolToVis}}"
                                      AutomationProperties.Name="31-band EQ">
                            <ItemsControl ItemsSource="{Binding ThirdOctaveBands}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Width="31" Margin="0,0,1,2">
                                            <TextBlock Text="{Binding GainText}" HorizontalAlignment="Center" FontSize="9" Foreground="{StaticResource TextDim}" />
                                            <Slider Orientation="Vertical" Minimum="-24" Maximum="24" Height="78" Margin="0,3"
                                                    TickFrequency="0.5" IsSnapToTickEnabled="True" SmallChange="0.5" LargeChange="3"
                                                    HorizontalAlignment="Center" Value="{Binding Gain, Mode=TwoWay}" ToolTip="{Binding Tooltip}"
                                                    AutomationProperties.Name="{Binding Label}" />
                                            <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" FontSize="9.5" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>

            <!-- ======================== status + what it applies to -->
            <StackPanel Grid.Row="3" Margin="0,6,0,0">
                <TextBlock Text="{Binding Main.EffectsStatusText}" Foreground="{StaticResource TextDim}" FontSize="11" TextWrapping="Wrap"
                           AutomationProperties.Name="Effects status" />
                <TextBlock Text="{Binding CaptionText}" Foreground="{StaticResource TextFaint}" FontSize="11" TextWrapping="Wrap"
                           AutomationProperties.Name="Effects caption" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
