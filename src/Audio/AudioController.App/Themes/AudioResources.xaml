<!--
  RigControl: everything the standalone App.xaml put in Application.Resources (the dark theme plus the converters,
  under the same keys). The host merges it into its own Application.Resources before any audio view is created:
    pack://application:,,,/AudioController;component/Themes/AudioResources.xaml  (AudioHost.ResourcesUri)
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:AudioController.App.Converters">
    <ResourceDictionary.MergedDictionaries>
        <!-- Dark theme: colors, brushes and control templates (no external theme packages). -->
        <ResourceDictionary Source="/AudioController;component/Themes/DarkTheme.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    <conv:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
    <conv:NullToVisibilityConverter x:Key="NullToVis" />
    <conv:NullToVisibilityConverter x:Key="InverseNullToVis" Invert="True" />
    <conv:CountToVisibilityConverter x:Key="ZeroToVis" />
    <conv:InverseBoolConverter x:Key="InverseBool" />
    <conv:HexToBrushConverter x:Key="HexToBrush" />
    <conv:HexToForegroundConverter x:Key="HexToForeground" />
    <conv:EqualsMultiConverter x:Key="EqualsMulti" />
</ResourceDictionary>
