<Window x:Class="AudioController.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:AudioController.App.Controls"
        Title="Settings" Width="720" Height="760" MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource WindowBg}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="12">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="18,8,18,12">

                <!-- ============================== setup: the two picks -->
                <TextBlock Text="SETUP" Style="{StaticResource SectionHeader}" />
                <controls:SetupCard DataContext="{Binding Main}" />
                <CheckBox Content="Hear soundboard locally (your sounds also play on your headset)" IsChecked="{Binding MonitorEnabled}"
                          Margin="2,10,0,0" AutomationProperties.Name="Hear soundboard locally" />

                <!-- ============================== hotkeys and devices -->
                <TextBlock Text="HOTKEYS AND DEVICES" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource Card}" Padding="14,10">
                    <StackPanel>
                        <TextBlock Text="Stop all sounds (global hotkey)" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                        <controls:HotkeyCaptureBox Gesture="{Binding StopAllHotkey, Mode=TwoWay}" HasConflict="{Binding HasStopAllConflict}"
                                                   MaxWidth="280" HorizontalAlignment="Left" MinWidth="220" />
                        <TextBlock Text="{Binding StopAllConflict, StringFormat='Conflict: {0}'}" Foreground="{StaticResource Danger}" TextWrapping="Wrap"
                                   Margin="0,4,0,0" Visibility="{Binding StopAllConflict, Converter={StaticResource NullToVis}}" />
                        <TextBlock Text="Click the box and press a key combination; Esc clears it. The stop-all hotkey is always registered before sound hotkeys."
                                   Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="0,4,0,10" />
                        <CheckBox Content="&quot;Default&quot; also sets the default communications device" IsChecked="{Binding SetDefaultCommunications}" />
                    </StackPanel>
                </Border>

                <!-- ============================== EQ -->
                <TextBlock Text="EQ AND EFFECTS" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource Card}" Padding="14,10">
                    <StackPanel>
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" Content="Open Effects" Style="{StaticResource AccentButton}" Padding="14,5" Margin="12,0,0,0"
                                    VerticalAlignment="Center" Click="OpenEffects_Click" AutomationProperties.Name="Open Effects"
                                    ToolTip="Closes Settings and shows the Effects panel in the main window" />
                            <TextBlock Text="{Binding EffectsNote}" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.Name="Effects note" />
                        </DockPanel>
                        <TextBlock Text="{Binding EffectsCaption}" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   AutomationProperties.Name="What the effects apply to" />
                        <TextBlock Text="{Binding EqNote}" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" FontSize="11.5" Margin="0,6,0,0"
                                   AutomationProperties.Name="Headset EQ note" />
                        <CheckBox IsChecked="{Binding EqAutoPreamp}" Margin="0,8,0,0" AutomationProperties.Name="Auto pre-amp"
                                  ToolTip="{Binding EqAutoPreampHelp}">
                            <TextBlock Text="Auto pre-amp: lower the whole level by my biggest boost" TextWrapping="Wrap" />
                        </CheckBox>
                        <TextBlock Text="{Binding EqAutoPreampHelp}" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" FontSize="11.5"
                                   Margin="24,3,0,0" AutomationProperties.Name="Auto pre-amp explanation" />
                    </StackPanel>
                </Border>

                <!-- ============================== advanced (collapsed): manual routing overrides -->
                <Expander x:Name="AdvancedExpander" Header="Advanced" IsExpanded="False" Margin="0,14,0,0" FontWeight="SemiBold">
                    <StackPanel TextElement.FontWeight="Normal">
                        <TextBlock Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="2,0,0,8"
                                   Text="Normally everything here follows your Setup picks automatically. Change it only if you know you need to; picking a headset again resets the monitor and System EQ output." />

                        <TextBlock Text="VIRTUAL MICROPHONE" Style="{StaticResource SectionHeader}" />
                        <Border Style="{StaticResource Card}" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="Virtual output (what other apps hear — normally the virtual mic feed, found automatically)" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding OutputOptions}" DisplayMemberPath="Name" SelectedValuePath="Id"
                                          SelectedValue="{Binding SelectedOutputId}" AutomationProperties.Name="Virtual microphone output" />
                                <TextBlock Text="{Binding VirtualMicFeedText}" Foreground="{StaticResource TextDim}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                                           AutomationProperties.Name="Virtual mic feed" />
                                <TextBlock Text="{Binding VirtualMicText}" Foreground="{StaticResource TextDim}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"
                                           AutomationProperties.Name="Virtual mic" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Ellipse Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource Danger}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Main.EngineRunning}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource Success}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding Main.MicStatusText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Main.MicStatusDetail, StringFormat=' — {0}'}" Foreground="{StaticResource TextDim}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding Main.MicStatusDetail, Converter={StaticResource NullToVis}}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="MONITORING" Style="{StaticResource SectionHeader}" />
                        <Border Style="{StaticResource Card}" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="Monitor device (soundboard only — never your microphone; normally your headset)" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding MonitorOptions}" DisplayMemberPath="Name" SelectedValuePath="Id"
                                          SelectedValue="{Binding SelectedMonitorId}" AutomationProperties.Name="Monitor device" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="SYSTEM EQ (PC-AUDIO ROUTE)" Style="{StaticResource SectionHeader}" />
                        <Border Style="{StaticResource Card}" Padding="14,10">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextDim}"
                                           Text="Used by &quot;EQ everything I hear&quot; only when Equalizer APO is not attached to your headset. The app sets the source as the Windows default output and plays it on the output through the EQ, while the app is open." />
                                <TextBlock Text="Source (a spare virtual playback device — never the virtual mic feed)" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding SystemEqSourceOptions}" DisplayMemberPath="Name" SelectedValuePath="Id"
                                          SelectedValue="{Binding SelectedSystemEqSourceId}" AutomationProperties.Name="System EQ source" />
                                <TextBlock Text="{Binding Main.InletName, StringFormat='In use: {0}'}" Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource TextDim}" />

                                <TextBlock Text="Output (normally your headset)" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding SystemEqOutputOptions}" DisplayMemberPath="Name" SelectedValuePath="Id"
                                          SelectedValue="{Binding SelectedSystemEqOutputId}" AutomationProperties.Name="System EQ output" />

                                <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextDim}"
                                           Text="To send PC audio through the EQ, or straight to your headset again, tick or untick &quot;EQ everything I hear&quot; in Setup: the app then moves the Windows default output itself (router first, so there is no silence)." />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Ellipse Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource TextFaint}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Main.SystemEqRunning}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource Success}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding Main.SystemEqStatusText}" FontWeight="SemiBold" VerticalAlignment="Center"
                                               TextWrapping="Wrap" MaxWidth="600" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Expander>

                <TextBlock Text="{Binding Main.StatusMessage}" TextWrapping="Wrap" Margin="2,10,0,0" FontSize="11"
                           Visibility="{Binding Main.StatusMessage, Converter={StaticResource NullToVis}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextDim}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Main.StatusIsError}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Warning}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="18,10">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="{StaticResource TextDim}"
                           Text="Changes apply immediately and are saved encrypted." />
                <Button DockPanel.Dock="Right" Content="Close" MinWidth="90" IsCancel="True"
                        Style="{StaticResource AccentButton}" Click="Close_Click" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
