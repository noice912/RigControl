<Window x:Class="AudioController.App.ReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Report" Width="560" MinWidth="380" MinHeight="220" SizeToContent="Height" MaxHeight="640"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        Background="{StaticResource WindowBg}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="12">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="SummaryText" TextWrapping="Wrap" FontSize="13" Margin="0,0,0,12" />

        <Border Grid.Row="1" Style="{StaticResource Panel}" Padding="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="LinesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="6,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="Glyph" Style="{StaticResource IconText}" VerticalAlignment="Top" Margin="0,2,0,0"
                                           Text="&#xE73E;" Foreground="{StaticResource Success}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Detail}" Foreground="{StaticResource TextDim}" TextWrapping="Wrap"
                                               Visibility="{Binding Detail, Converter={StaticResource NullToVis}}" />
                                </StackPanel>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Ok}" Value="False">
                                    <Setter TargetName="Glyph" Property="Text" Value="&#xE711;" />
                                    <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource Danger}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="CopyButton" Content="Copy" MinWidth="80" Margin="0,0,8,0" Click="Copy_Click" />
            <Button Content="OK" MinWidth="90" IsDefault="True" IsCancel="True" Style="{StaticResource AccentButton}" Click="Ok_Click" />
        </StackPanel>
    </Grid>
</Window>
