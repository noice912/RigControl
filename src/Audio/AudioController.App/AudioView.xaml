<!-- RigControl: was MainWindow (a Window). The content is unchanged; the window's Title/Width/Height/MinWidth/MinHeight
     are gone because the host owns the window (it should keep the audio area at least 1000 x 660, the old minimum). -->
<UserControl x:Class="AudioController.App.AudioView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AudioController.App"
        xmlns:vm="clr-namespace:AudioController.App.ViewModels"
        xmlns:services="clr-namespace:AudioController.App.Services"
        xmlns:controls="clr-namespace:AudioController.App.Controls"
        Background="{StaticResource WindowBg}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="12" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <UserControl.Resources>

        <!-- ============================================================ mic mute toggle -->
        <!-- Unchecked: neutral "Mute Mic". Checked: solid red "Mic Muted" with a crossed-out mic. -->
        <Style x:Key="MicMuteToggle" TargetType="ToggleButton">
            <Setter Property="Background" Value="{StaticResource ControlBg}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinWidth" Value="128" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" SnapsToDevicePixels="True">
                            <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="Glyph" Text="&#xE720;" Style="{StaticResource IconText}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="Label" Text="Mute Mic" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ControlHover}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Danger}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Danger}" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter TargetName="Glyph" Property="Text" Value="&#xF781;" />
                                <Setter TargetName="Label" Property="Text" Value="Mic Muted" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource DangerHover}" />
                            </MultiTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================================ slot tile -->
        <Style x:Key="SlotTile" TargetType="Button">
            <Setter Property="Width" Value="150" />
            <Setter Property="Height" Value="92" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Glow" CornerRadius="11" Margin="-3" BorderThickness="3" BorderBrush="Transparent" />
                            <Border x:Name="Bd" CornerRadius="8" BorderThickness="1" BorderBrush="#40000000"
                                    Background="{Binding ColorHex, Converter={StaticResource HexToBrush}}">
                                <Grid Margin="10,8,10,7">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis" MaxHeight="38" VerticalAlignment="Top"
                                               Foreground="{Binding ColorHex, Converter={StaticResource HexToForeground}}" />
                                    <TextBlock Grid.Row="1" Text="{Binding Caption}" FontSize="11" Opacity="0.85" TextTrimming="CharacterEllipsis"
                                               Foreground="{Binding ColorHex, Converter={StaticResource HexToForeground}}" />
                                    <Border x:Name="ConflictTag" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-5,0"
                                            CornerRadius="9" Width="18" Height="18" Background="#E6101318" Visibility="Collapsed"
                                            ToolTip="{Binding HotkeyConflict}">
                                        <TextBlock Text="&#xE7BA;" Style="{StaticResource IconText}" FontSize="10" HorizontalAlignment="Center"
                                                   Foreground="{StaticResource Warning}" />
                                    </Border>
                                    <Border x:Name="PlayingTag" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                            CornerRadius="3" Background="#D9101318" Padding="5,1" Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE768;" Style="{StaticResource IconText}" FontSize="9" Foreground="{StaticResource Success}" Margin="0,0,4,0" />
                                            <TextBlock Text="PLAYING" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Success}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                            <Border x:Name="Shade" CornerRadius="8" Background="White" Opacity="0" IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shade" Property="Opacity" Value="0.08" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Shade" Property="Opacity" Value="0.18" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="White" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasHotkeyConflict}" Value="True">
                                <Setter TargetName="ConflictTag" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                <Setter TargetName="Glow" Property="BorderBrush" Value="{StaticResource Success}" />
                                <Setter TargetName="Glow" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="{StaticResource SuccessColor}" BlurRadius="16" ShadowDepth="0" Opacity="0.9" />
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="PlayingTag" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================================ shared device-row pieces -->
        <DataTemplate x:Key="VolumeRow">
            <Grid Margin="0,5,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>
                <ToggleButton Style="{StaticResource MuteToggle}" IsChecked="{Binding Muted}" IsEnabled="{Binding IsActive}" />
                <Slider Grid.Column="1" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" Margin="6,0"
                        VerticalAlignment="Center" Value="{Binding Volume, Mode=TwoWay}" IsEnabled="{Binding IsActive}"
                        ToolTip="Master volume (0–100)" />
                <TextBlock Grid.Column="2" Text="{Binding VolumeText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Foreground="{StaticResource TextDim}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="DeviceRow" DataType="{x:Type vm:DeviceViewModel}">
            <Border Style="{StaticResource Card}" ToolTip="{Binding Tooltip}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Default" Style="{StaticResource SmallButton}" Margin="6,0,0,0"
                                Command="{Binding MakeDefaultCommand}" ToolTip="Make this the Windows default device" />
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock x:Name="State" Text="{Binding StateText}" FontSize="11" Foreground="{StaticResource Success}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <Border Style="{StaticResource Badge}" Visibility="{Binding RoleText, Converter={StaticResource NullToVis}}">
                            <TextBlock Text="{Binding RoleText}" FontSize="10" Foreground="{StaticResource Accent}" />
                        </Border>
                        <Border Style="{StaticResource Badge}" Visibility="{Binding IsBluetooth, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Bluetooth" FontSize="10" Foreground="{StaticResource TextDim}" />
                        </Border>
                    </StackPanel>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource VolumeRow}" Focusable="False" />
                    <CheckBox Content="Audio Enhancements" FontSize="11" Margin="0,6,0,0" IsChecked="{Binding EnhancementsEnabled}"
                              IsEnabled="{Binding IsActive}" Visibility="{Binding EnhancementsSupported, Converter={StaticResource BoolToVis}}"
                              ToolTip="Windows &quot;Audio Enhancements&quot; for this device (best effort; some drivers lock it)" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="False">
                    <Setter TargetName="State" Property="Foreground" Value="{StaticResource TextFaint}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="HeadphoneRow" DataType="{x:Type vm:DeviceViewModel}">
            <Border Style="{StaticResource Card}" ToolTip="{Binding Tooltip}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Default" Style="{StaticResource SmallButton}" Margin="6,0,0,0"
                                Command="{Binding MakeDefaultCommand}" ToolTip="Make these headphones the Windows default device" />
                        <TextBlock DockPanel.Dock="Left" Text="&#xE7F6;" Style="{StaticResource IconText}" Foreground="{StaticResource Accent}" Margin="0,0,7,0" />
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </DockPanel>
                    <WrapPanel Margin="0,4,0,0">
                        <TextBlock x:Name="State" Text="{Binding StateText}" FontSize="11" Foreground="{StaticResource Success}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="&#xE83F;" Style="{StaticResource IconText}" FontSize="12" Foreground="{StaticResource TextDim}" Margin="0,0,4,0" />
                        <TextBlock Text="{Binding BatteryText}" FontSize="11" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="0,0,8,0"
                                   ToolTip="Battery (best effort — Windows only reports it for some headsets; — means unknown)" />
                        <Border Style="{StaticResource Badge}" Background="#FF2E2614" BorderBrush="{StaticResource Warning}" BorderThickness="1"
                                Visibility="{Binding IsSkullcandy, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="SKULLCANDY" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource Warning}" />
                        </Border>
                        <Border Style="{StaticResource Badge}" Visibility="{Binding RoleText, Converter={StaticResource NullToVis}}">
                            <TextBlock Text="{Binding RoleText}" FontSize="10" Foreground="{StaticResource Accent}" />
                        </Border>
                    </WrapPanel>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource VolumeRow}" Focusable="False" />
                    <TextBlock Text="{x:Static vm:DeviceViewModel.SkullcandyNote}" TextWrapping="Wrap" FontSize="11" Margin="0,7,0,0"
                               Foreground="{StaticResource TextDim}" Visibility="{Binding ShowSkullcandyNote, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="False">
                    <Setter TargetName="State" Property="Foreground" Value="{StaticResource TextFaint}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================================================ top bar -->
        <Border Grid.Row="0" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,7">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <TextBlock Text="&#xE7F5;" Style="{StaticResource IconText}" FontSize="16" Foreground="{StaticResource Accent}" />
                    <TextBlock Text="Audio Controller" FontSize="15" FontWeight="SemiBold" Margin="9,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Text="local · encrypted · no network" Foreground="{StaticResource TextFaint}" VerticalAlignment="Center" />
                </StackPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE713;" FontSize="16" Padding="8,6"
                        AutomationProperties.Name="Settings"
                        ToolTip="Settings — microphone and headset, stop-all hotkey, Equalizer APO pre-amp, advanced routing" Click="Settings_Click" />
            </DockPanel>
        </Border>

        <!-- ============================================================ banners -->
        <StackPanel Grid.Row="1">
            <!-- Windows' default output is the virtual-mic cable: Discord hears the PC, the headset hears nothing. -->
            <Border Background="{StaticResource DangerBannerBg}" BorderBrush="{StaticResource Danger}" BorderThickness="0,0,0,1" Padding="14,10"
                    AutomationProperties.Name="PC audio misrouted"
                    Visibility="{Binding ShowMisrouteBanner, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" Style="{StaticResource IconText}" FontSize="17" Foreground="{StaticResource Danger}" Margin="0,0,10,0" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="Fix it" Padding="16,5" Margin="10,0,0,0"
                            Command="{Binding FixMisrouteCommand}" AutomationProperties.Name="Fix it"
                            ToolTip="Point Windows' default output back at your headset (or at Audio Controller while it routes your PC audio)" />
                    <TextBlock Text="{Binding MisrouteBannerText}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" />
                </DockPanel>
            </Border>
            <Border Background="{StaticResource DangerBannerBg}" BorderBrush="{StaticResource Danger}" BorderThickness="0,0,0,1" Padding="14,8"
                    Visibility="{Binding ShowCableBanner, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" Style="{StaticResource IconText}" FontSize="15" Foreground="{StaticResource Danger}" Margin="0,0,10,0" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="11" ToolTip="Dismiss"
                            AutomationProperties.Name="Dismiss virtual cable message" Command="{Binding DismissCableBannerCommand}" />
                    <Button DockPanel.Dock="Right" Content="Recheck" Margin="10,0,6,0" Command="{Binding RecheckCableCommand}" />
                    <TextBlock Text="{Binding CableBannerText}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12.5" />
                </DockPanel>
            </Border>
            <Border Background="{StaticResource WarningBannerBg}" BorderBrush="{StaticResource Warning}" BorderThickness="0,0,0,1" Padding="14,8"
                    Visibility="{Binding ShowFfmpegBanner, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" Style="{StaticResource IconText}" FontSize="15" Foreground="{StaticResource Warning}" Margin="0,0,10,0" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="11" ToolTip="Dismiss"
                            AutomationProperties.Name="Dismiss FFmpeg message" Command="{Binding DismissFfmpegBannerCommand}" />
                    <TextBlock Text="{Binding FfmpegBannerText}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12.5" />
                </DockPanel>
            </Border>
        </StackPanel>

        <!-- ============================================================ main panels -->
        <Grid Grid.Row="2" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="260" MaxWidth="460" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" MinWidth="360" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="310" MinWidth="260" MaxWidth="440" />
            </Grid.ColumnDefinitions>

            <!-- ======================== LEFT: setup + devices -->
            <Border Grid.Column="0" Style="{StaticResource Panel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="10,10,10,8">
                            <!-- the two things to set: microphone and headset -->
                            <controls:SetupCard />

                            <DockPanel Margin="2,14,-2,0">
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE72C;" FontSize="12"
                                        AutomationProperties.Name="Refresh devices"
                                        ToolTip="Refresh devices" Command="{Binding RefreshDevicesCommand}" />
                                <TextBlock Text="Devices" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </DockPanel>

                            <TextBlock Text="OUTPUTS" Style="{StaticResource SectionHeader}" />
                            <ItemsControl ItemsSource="{Binding Outputs}" ItemTemplate="{StaticResource DeviceRow}" Focusable="False" />
                            <TextBlock Text="No active playback devices." Foreground="{StaticResource TextFaint}" Margin="2,0,0,6"
                                       Visibility="{Binding Outputs.Count, Converter={StaticResource ZeroToVis}}" />

                            <TextBlock Text="INPUTS" Style="{StaticResource SectionHeader}" />
                            <ItemsControl ItemsSource="{Binding Inputs}" ItemTemplate="{StaticResource DeviceRow}" Focusable="False" />
                            <TextBlock Text="No active recording devices." Foreground="{StaticResource TextFaint}" Margin="2,0,0,6"
                                       Visibility="{Binding Inputs.Count, Converter={StaticResource ZeroToVis}}" />

                            <StackPanel Visibility="{Binding HasHeadphones, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="HEADPHONES (BLUETOOTH)" Style="{StaticResource SectionHeader}" />
                                <ItemsControl ItemsSource="{Binding Headphones}" ItemTemplate="{StaticResource HeadphoneRow}" Focusable="False" />
                            </StackPanel>

                            <TextBlock Text="{Binding DeviceError}" Foreground="{StaticResource Danger}" TextWrapping="Wrap" Margin="2,8,0,0"
                                       Visibility="{Binding DeviceError, Converter={StaticResource NullToVis}}" />
                        </StackPanel>
                    </ScrollViewer>
                    <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,7">
                        <CheckBox Content="{Binding InactiveToggleText}" IsChecked="{Binding ShowInactiveDevices}" FontSize="11"
                                  Foreground="{StaticResource TextDim}" />
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext" Cursor="SizeWE" />

            <!-- ======================== CENTER: boards -->
            <Border Grid.Column="2" Style="{StaticResource Panel}" AllowDrop="True"
                    PreviewDragEnter="Boards_PreviewDragOver" PreviewDragOver="Boards_PreviewDragOver"
                    PreviewDragLeave="Boards_PreviewDragLeave" PreviewDrop="Boards_PreviewDrop">
                <Grid>
                    <Grid Margin="10,9,10,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Left" Text="Soundboards" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="2,0,14,0" />
                            <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Click="Import_Click" IsEnabled="{Binding CanImport}"
                                    ToolTip="Import audio files into the current board (any format FFmpeg can decode, up to 30 s each). You can also drag files onto the board.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B5;" Style="{StaticResource IconText}" Margin="0,0,7,0" />
                                    <TextBlock Text="Import sounds…" />
                                </StackPanel>
                            </Button>
                            <Button DockPanel.Dock="Right" Command="{Binding AddBoardCommand}" Margin="0,0,8,0" ToolTip="Add a new board">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" Style="{StaticResource IconText}" Margin="0,0,7,0" FontSize="11" />
                                    <TextBlock Text="Add board" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{Binding ImportProgressText}" Foreground="{StaticResource TextDim}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                        </DockPanel>

                        <TabControl Grid.Row="1" Margin="0,10,0,0" ItemsSource="{Binding Boards}" SelectedItem="{Binding SelectedBoard}">
                            <TabControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:BoardViewModel}">
                                    <Grid Background="Transparent" MouseLeftButtonDown="BoardHeader_MouseLeftButtonDown"
                                          ToolTip="Double-click to rename · right-click for more">
                                        <Grid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Rename" Command="{Binding BeginRenameCommand}" />
                                                <MenuItem Header="Delete board…" Command="{Binding DeleteCommand}" />
                                            </ContextMenu>
                                        </Grid.ContextMenu>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVis}}" />
                                        <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" MinWidth="110" Padding="4,1"
                                                 Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"
                                                 KeyDown="BoardName_KeyDown" LostKeyboardFocus="BoardName_LostKeyboardFocus"
                                                 IsVisibleChanged="BoardName_IsVisibleChanged" />
                                    </Grid>
                                </DataTemplate>
                            </TabControl.ItemTemplate>
                            <TabControl.ContentTemplate>
                                <DataTemplate DataType="{x:Type vm:BoardViewModel}">
                                    <Grid>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="6">
                                            <ItemsControl ItemsSource="{Binding Slots}" Focusable="False">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:SlotViewModel}">
                                                        <Button Style="{StaticResource SlotTile}"
                                                                AutomationProperties.Name="{Binding DisplayName}"
                                                                Click="Slot_Click"
                                                                PreviewMouseLeftButtonDown="Slot_PreviewMouseLeftButtonDown"
                                                                PreviewMouseLeftButtonUp="Slot_PreviewMouseLeftButtonUp"
                                                                PreviewMouseMove="Slot_PreviewMouseMove"
                                                                MouseLeave="Slot_MouseLeave"
                                                                LostMouseCapture="Slot_LostMouseCapture">
                                                            <Button.ToolTip>
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                                    <TextBlock Text="{Binding PlayModeLabel, StringFormat='Mode: {0}'}" />
                                                                    <TextBlock Text="{Binding DurationText, StringFormat='Length: {0}'}" />
                                                                    <TextBlock Text="{Binding HotkeyDisplay, StringFormat='Hotkey: {0}'}"
                                                                               Visibility="{Binding Hotkey, Converter={StaticResource NullToVis}}" />
                                                                    <TextBlock Text="{Binding HotkeyConflict}" Foreground="{StaticResource Danger}"
                                                                               Visibility="{Binding HotkeyConflict, Converter={StaticResource NullToVis}}" />
                                                                </StackPanel>
                                                            </Button.ToolTip>
                                                            <Button.ContextMenu>
                                                                <ContextMenu>
                                                                    <MenuItem Header="Play / stop" Command="{Binding PlayCommand}" />
                                                                    <MenuItem Header="Delete sound…" Command="{Binding DeleteCommand}" />
                                                                </ContextMenu>
                                                            </Button.ContextMenu>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                                    Visibility="{Binding Slots.Count, Converter={StaticResource ZeroToVis}}">
                                            <TextBlock Text="&#xE8B5;" Style="{StaticResource IconText}" FontSize="30" HorizontalAlignment="Center"
                                                       Foreground="{StaticResource TextFaint}" />
                                            <TextBlock Text="This board is empty" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,4" />
                                            <TextBlock Text="Drag audio files here, or click Import sounds…" Foreground="{StaticResource TextDim}" HorizontalAlignment="Center" />
                                            <TextBlock Text="MP3, WAV, FLAC, OGG, OPUS, AAC, M4A, WMA, AIFF, APE, ALAC, AMR, AC3, WV, MP2, TTA, MKV/MP4 audio · up to 30 s"
                                                       Foreground="{StaticResource TextFaint}" FontSize="11" HorizontalAlignment="Center" Margin="0,6,0,0"
                                                       TextWrapping="Wrap" TextAlignment="Center" MaxWidth="380" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </TabControl.ContentTemplate>
                        </TabControl>
                    </Grid>

                    <Border x:Name="DropOverlay" CornerRadius="8" Background="#CC14161B" BorderBrush="{StaticResource Accent}"
                            BorderThickness="2" Visibility="Collapsed" IsHitTestVisible="False">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xE8B5;" Style="{StaticResource IconText}" FontSize="34" HorizontalAlignment="Center" Foreground="{StaticResource Accent}" />
                            <TextBlock x:Name="DropOverlayText" Text="Drop to import into this board" FontSize="15" FontWeight="SemiBold" Margin="0,10,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext" Cursor="SizeWE" />

            <!-- ======================== RIGHT: slot editor -->
            <Border Grid.Column="4" Style="{StaticResource Panel}">
                <Grid>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20"
                                Visibility="{Binding HasSelectedSlot, Converter={StaticResource InverseBoolToVis}}">
                        <TextBlock Text="&#xE70F;" Style="{StaticResource IconText}" FontSize="26" HorizontalAlignment="Center" Foreground="{StaticResource TextFaint}" />
                        <TextBlock Text="Select a sound to edit it" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,4" />
                        <TextBlock Text="Name, color, hotkey, volume and play mode live here." Foreground="{StaticResource TextDim}"
                                   TextWrapping="Wrap" TextAlignment="Center" />
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  DataContext="{Binding SelectedSlot}"
                                  Visibility="{Binding DataContext.HasSelectedSlot, RelativeSource={RelativeSource AncestorType=local:AudioView}, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="14,9,14,14">
                            <TextBlock Text="Sound settings" FontSize="14" FontWeight="SemiBold" />

                            <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" />

                            <TextBlock Text="Color" Style="{StaticResource FieldLabel}" />
                            <ItemsControl ItemsSource="{x:Static services:Palette.Colors}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Width="24" Height="24" Margin="0,0,6,6" Cursor="Hand" ToolTip="{Binding}"
                                                Command="{Binding DataContext.SetColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Grid>
                                                        <Ellipse x:Name="Ring" Stroke="White" StrokeThickness="2" Visibility="Collapsed" />
                                                        <Ellipse Margin="3" Fill="{Binding Converter={StaticResource HexToBrush}}" />
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Value="True">
                                                            <DataTrigger.Binding>
                                                                <MultiBinding Converter="{StaticResource EqualsMulti}">
                                                                    <Binding />
                                                                    <Binding Path="DataContext.ColorHex" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                                </MultiBinding>
                                                            </DataTrigger.Binding>
                                                            <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                                                            <Setter TargetName="Ring" Property="Opacity" Value="0.6" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Global hotkey" Style="{StaticResource FieldLabel}" Margin="0,4,0,4"
                                       ToolTip="Works while the app is in the background. Click the box, press the keys; Esc clears." />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <controls:HotkeyCaptureBox Gesture="{Binding Hotkey, Mode=TwoWay}" HasConflict="{Binding HasHotkeyConflict}" />
                                <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="10" Margin="4,0,0,0"
                                        AutomationProperties.Name="Clear hotkey"
                                        ToolTip="Clear hotkey" Command="{Binding ClearHotkeyCommand}" />
                            </Grid>
                            <TextBlock Text="{Binding HotkeyConflict, StringFormat='Conflict: {0}'}" Foreground="{StaticResource Danger}" TextWrapping="Wrap"
                                       Margin="0,4,0,0" Visibility="{Binding HotkeyConflict, Converter={StaticResource NullToVis}}" />

                            <TextBlock Text="Volume" Style="{StaticResource FieldLabel}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="46" />
                                </Grid.ColumnDefinitions>
                                <Slider Minimum="0" Maximum="200" SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True"
                                        Value="{Binding VolumePercent, Mode=TwoWay}" VerticalAlignment="Center"
                                        ToolTip="Slot volume, 0–200 % (applies the next time the sound starts)" />
                                <TextBlock Grid.Column="1" Text="{Binding VolumePercent, StringFormat='{}{0:0}%'}" HorizontalAlignment="Right"
                                           VerticalAlignment="Center" Foreground="{StaticResource TextDim}" />
                            </Grid>

                            <TextBlock Text="Play mode" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="PlayModeBox" ItemsSource="{x:Static vm:PlayModeOption.All}" DisplayMemberPath="Label"
                                      SelectedValuePath="Value" SelectedValue="{Binding PlayMode}"
                                      ToolTip="{Binding SelectedItem.Description, RelativeSource={RelativeSource Self}}" />
                            <TextBlock Text="{Binding SelectedItem.Description, ElementName=PlayModeBox}" Foreground="{StaticResource TextDim}"
                                       TextWrapping="Wrap" FontSize="11" Margin="0,5,0,0" />

                            <TextBlock Text="File" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Original" Foreground="{StaticResource TextDim}" Margin="0,0,12,4" />
                                    <TextBlock Grid.Column="1" Text="{Binding OriginalFileName}" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"
                                               ToolTip="{Binding OriginalFileName}" />
                                    <TextBlock Grid.Row="1" Text="Duration" Foreground="{StaticResource TextDim}" Margin="0,0,12,4" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DurationText}" Margin="0,0,0,4" />
                                    <TextBlock Grid.Row="2" Text="Size" Foreground="{StaticResource TextDim}" Margin="0,0,12,0" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SizeText}" />
                                </Grid>
                            </Border>
                            <TextBlock Text="Stored encrypted as 48 kHz float WAV. The original file is not kept or modified."
                                       Foreground="{StaticResource TextFaint}" FontSize="11" TextWrapping="Wrap" />

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource AccentButton}" Command="{Binding PreviewCommand}" Padding="10,7"
                                        ToolTip="Play through the virtual mic (and the local monitor if enabled), like clicking the slot">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE768;" Style="{StaticResource IconText}" Margin="0,0,7,0" />
                                        <TextBlock Text="Preview" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2" Command="{Binding DeleteCommand}" Padding="10,7" BorderBrush="{StaticResource Danger}"
                                        Foreground="{StaticResource Danger}" ToolTip="Delete this slot (asks first)">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74D;" Style="{StaticResource IconText}" Margin="0,0,7,0" />
                                        <TextBlock Text="Delete slot" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ============================================================ effects (FXSound-style): always visible -->
        <controls:EffectsPanel x:Name="EffectsPanel" Grid.Row="3" Margin="10,0,10,10" DataContext="{Binding Effects}" />

        <!-- ============================================================ bottom bar -->
        <Border Grid.Row="4" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- virtual mic status -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" MaxWidth="460">
                    <Ellipse Width="10" Height="10" Margin="0,0,9,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource Danger}" />
                                <Setter Property="ToolTip" Value="Virtual mic routing is stopped" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EngineRunning}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource Success}" />
                                        <Setter Property="ToolTip" Value="Virtual mic routing is running" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding MicStatusText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="440"
                                   ToolTip="{Binding MicStatusText}" />
                        <TextBlock Text="{Binding MicStatusDetail}" Foreground="{StaticResource TextDim}" FontSize="11" TextTrimming="CharacterEllipsis"
                                   MaxWidth="440" ToolTip="{Binding MicStatusDetail}"
                                   Visibility="{Binding MicStatusDetail, Converter={StaticResource NullToVis}}" />
                    </StackPanel>
                </StackPanel>

                <!-- sound playing indicator + System EQ badge -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="10" Padding="9,3" Margin="16,0,0,0" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource ControlBg}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SoundPlaying}" Value="True">
                                        <Setter Property="Background" Value="#FF173A2A" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource TextFaint}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SoundPlaying}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource Success}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock FontSize="11" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="No sound playing" />
                                        <Setter Property="Foreground" Value="{StaticResource TextDim}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SoundPlaying}" Value="True">
                                                <Setter Property="Text" Value="Sound playing" />
                                                <Setter Property="Foreground" Value="{StaticResource Success}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="10" Padding="9,3" Margin="8,0,0,0" VerticalAlignment="Center" Background="#FF173A2A"
                            ToolTip="{Binding SystemEqStatusText}" AutomationProperties.Name="System EQ running"
                            Visibility="{Binding SystemEqRunning, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{StaticResource Success}" />
                            <TextBlock Text="SYS EQ" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{StaticResource Success}" />
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="10" Padding="9,3" Margin="8,0,0,0" VerticalAlignment="Center" Background="#FF173A2A"
                            ToolTip="{Binding ApoEqBadgeText}" AutomationProperties.Name="Equalizer APO EQ on"
                            Visibility="{Binding ApoEqRunning, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{StaticResource Success}" />
                            <TextBlock Text="EQ ALL" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{StaticResource Success}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- peak meter (display only) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center"
                            ToolTip="Peak level of the virtual mic output (display only — no processing)">
                    <Grid Width="170" Height="10" VerticalAlignment="Center">
                        <Rectangle RadiusX="3" RadiusY="3" Fill="{StaticResource MeterBrush}" />
                        <Rectangle RadiusX="3" RadiusY="3" Fill="{StaticResource ControlBg}" RenderTransformOrigin="1,0.5">
                            <Rectangle.RenderTransform>
                                <ScaleTransform ScaleX="{Binding PeakRemainder}" />
                            </Rectangle.RenderTransform>
                        </Rectangle>
                    </Grid>
                    <TextBlock Text="{Binding PeakText}" Foreground="{StaticResource TextDim}" FontSize="11" Width="56" Margin="8,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- transient status / errors -->
                <TextBlock Grid.Column="3" Text="{Binding StatusMessage}" Margin="14,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding StatusMessage}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextDim}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Warning}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <CheckBox Grid.Column="4" Content="Hear soundboard locally" IsChecked="{Binding MonitorEnabled}" Margin="0,0,16,0"
                          VerticalAlignment="Center"
                          ToolTip="Also play soundboard audio on your headset (the one picked in Setup). Your microphone is never sent there." />

                <!-- mic mute: releases the capture device entirely (not a zero-fill) -->
                <ToggleButton x:Name="MicMuteToggle" Grid.Column="5" Style="{StaticResource MicMuteToggle}" IsChecked="{Binding MicMuted}"
                              Margin="0,0,10,0" AutomationProperties.Name="Mute Mic"
                              ToolTip="Releases the microphone completely — Bluetooth headphones return to high-quality audio and Windows stops ducking. Soundboard keeps playing." />

                <Button Grid.Column="6" Style="{StaticResource DangerButton}" Command="{Binding StopAllCommand}" Padding="22,8" FontSize="14"
                        ToolTip="Stop every playing sound (the stop-all hotkey is set in Settings)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE71A;" Style="{StaticResource IconText}" Margin="0,0,8,0" />
                        <TextBlock Text="Stop All" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
