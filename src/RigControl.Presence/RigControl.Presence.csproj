<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>RigControl.Presence</RootNamespace>
    <!-- Windows media controls (Apple Music / Spotify) are a WinRT API. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RigControl.Core\RigControl.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The browser extension (from RichPresence), handed out by the Games page. -->
    <EmbeddedResource Include="..\..\extension\*" LogicalName="RigControl.Presence.Extension.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RigControl.Presence.Tests" />
  </ItemGroup>

  <!-- The Discord application ids, encrypted into the dll when private\discord-ids.json exists. -->
  <Import Project="DiscordIds.targets" />

</Project>
