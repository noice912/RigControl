<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>RigControl.Presence</RootNamespace>
    <!--
      Two flavours (docs/PORTING.md): the Windows one (media controls are a WinRT API, the game library, the
      launcher, the browser extension link) and a neutral one for Linux and macOS (custom statuses and a card for
      a running program, over Discord's Unix socket).
    -->
    <TargetFramework Condition="'$(TargetFramework)' == '$(RigWindowsDefaultTfm)'"></TargetFramework>
    <TargetFrameworks>$(RigDualTfms)</TargetFrameworks>
  </PropertyGroup>

  <!-- Files that only make sense on Windows are left out of the neutral flavour. Shared files use "#if WINDOWS". -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'windows'">
    <Compile Remove="Sessions.cs" />
    <Compile Remove="Launcher.cs" />
    <Compile Remove="WindowsParts.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../RigControl.Core/RigControl.Core.csproj" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <!-- The browser extension (from RichPresence), handed out by the Games page. Windows flavour only. -->
    <EmbeddedResource Include="../../extension/*" LogicalName="RigControl.Presence.Extension.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RigControl.Presence.Tests" />
  </ItemGroup>

  <!-- The Discord application ids, encrypted into the dll when private\discord-ids.json exists. -->
  <Import Project="DiscordIds.targets" />

</Project>
