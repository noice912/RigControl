<Window x:Class="RigControl.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="RigControl"
        Width="1320" Height="860"
        MinWidth="1000" MinHeight="660"
        Background="#161C23"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Must equal the rail width in the web UI (the rail-width variable in src/ui/src/styles.css). -->
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- The web UI. Spans the whole window, except while a native view (Audio) is shown: then it is only the rail. -->
        <wv2:WebView2 x:Name="WebView" Grid.Column="0" Grid.ColumnSpan="2" />

        <!-- Native views (the merged Audio Controller) appear here, to the right of the rail. -->
        <ContentControl x:Name="NativeHost" Grid.Column="1" Visibility="Collapsed" Focusable="False" />

        <Border x:Name="FallbackPanel" Grid.Column="0" Grid.ColumnSpan="2" Visibility="Collapsed" Background="#161C23" Padding="40">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="640">
                <TextBlock Text="RigControl could not start its interface" Foreground="#E4E9EE" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="FallbackText" Margin="0,16,0,0" Foreground="#95A3B2" FontSize="14" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
