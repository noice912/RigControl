<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 SDK projection: the Discord status module reads Windows media controls (WinRT). -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>RigControl</AssemblyName>
    <RootNamespace>RigControl.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WPF takes its DPI awareness from app.manifest; the WinForms analyzer (pulled in for the tray icon) would rather it did not. -->
    <NoWarn>$(NoWarn);WFO0003;WFAC010</NoWarn>
    <ApplicationIcon Condition="Exists('Assets\rigcontrol.ico')">Assets\rigcontrol.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- One self-contained exe: dotnet publish src\RigControl.App -c Release -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <!-- WPF, WinForms and reflection-heavy hardware libraries are not trim-safe. -->
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms is referenced only for the tray icon; keep its namespaces out of the implicit usings so they do not clash with WPF. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <!-- AppServices, AppSettings and UiAssets live in the shared hosting library. -->
    <Using Include="RigControl.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RigControl.Core\RigControl.Core.csproj" />
    <!-- What this app shares with the Linux/macOS host; it also carries the built web UI (src/ui). -->
    <ProjectReference Include="..\RigControl.Hosting\RigControl.Hosting.csproj" />
    <ProjectReference Include="..\RigControl.Sensors\RigControl.Sensors.csproj" />
    <ProjectReference Include="..\RigControl.Nvidia\RigControl.Nvidia.csproj" />
    <ProjectReference Include="..\RigControl.Cooling\RigControl.Cooling.csproj" />
    <ProjectReference Include="..\RigControl.Lighting\RigControl.Lighting.csproj" />
    <ProjectReference Include="..\RigControl.Capture\RigControl.Capture.csproj" />
    <ProjectReference Include="..\RigControl.Drivers\RigControl.Drivers.csproj" />
    <ProjectReference Include="..\RigControl.Bios\RigControl.Bios.csproj" />
    <ProjectReference Include="..\RigControl.Cpu\RigControl.Cpu.csproj" />
    <ProjectReference Include="..\RigControl.Presence\RigControl.Presence.csproj" />
    <!-- Finds other programs and Windows settings that get in RigControl's way (it only looks and explains). -->
    <ProjectReference Include="..\RigControl.Health\RigControl.Health.csproj" />
    <!-- OpenRGB, the PawnIO setup and the Equalizer APO setup, carried inside the exe (third_party/BUNDLED.md). -->
    <ProjectReference Include="..\RigControl.Bundled\RigControl.Bundled.csproj" />
    <!-- The merged Audio Controller (soundboard, virtual mic, EQ, "also play on"), hosted as the Audio section. -->
    <ProjectReference Include="..\Audio\AudioController.App\AudioController.App.csproj" />
  </ItemGroup>


  <ItemGroup>
    <InternalsVisibleTo Include="RigControl.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

</Project>
