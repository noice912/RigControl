<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 SDK projection: the Discord status module reads Windows media controls (WinRT). -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>RigControl</AssemblyName>
    <RootNamespace>RigControl.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WPF takes its DPI awareness from app.manifest; the WinForms analyzer (pulled in for the tray icon) would rather it did not. -->
    <NoWarn>$(NoWarn);WFO0003;WFAC010</NoWarn>
    <ApplicationIcon Condition="Exists('Assets\rigcontrol.ico')">Assets\rigcontrol.ico</ApplicationIcon>
    <!-- Program.Main, not WPF's generated Main: it checks where the native DLLs were unpacked before WPF loads any
         (NativeFolderGuard.cs). -->
    <StartupObject>RigControl.App.Program</StartupObject>
    <!-- No startup hooks: .NET would otherwise load any assembly named in DOTNET_STARTUP_HOOKS (an environment
         variable any program running as this user can set) into RigControl before Main, with administrator rights.
         Off in every configuration, so debug builds behave the same. -->
    <StartupHookSupport>false</StartupHookSupport>
  </PropertyGroup>

  <!-- One self-contained exe: dotnet publish src\RigControl.App -c Release -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <!-- WPF, WinForms and reflection-heavy hardware libraries are not trim-safe. -->
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms is referenced only for the tray icon; keep its namespaces out of the implicit usings so they do not clash with WPF. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <!-- AppServices, AppSettings and UiAssets live in the shared hosting library. -->
    <Using Include="RigControl.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RigControl.Core\RigControl.Core.csproj" />
    <!-- What this app shares with the Linux/macOS host; it also carries the built web UI (src/ui). -->
    <ProjectReference Include="..\RigControl.Hosting\RigControl.Hosting.csproj" />
    <ProjectReference Include="..\RigControl.Sensors\RigControl.Sensors.csproj" />
    <ProjectReference Include="..\RigControl.Nvidia\RigControl.Nvidia.csproj" />
    <ProjectReference Include="..\RigControl.Cooling\RigControl.Cooling.csproj" />
    <ProjectReference Include="..\RigControl.Lighting\RigControl.Lighting.csproj" />
    <ProjectReference Include="..\RigControl.Capture\RigControl.Capture.csproj" />
    <ProjectReference Include="..\RigControl.Drivers\RigControl.Drivers.csproj" />
    <ProjectReference Include="..\RigControl.Bios\RigControl.Bios.csproj" />
    <ProjectReference Include="..\RigControl.Cpu\RigControl.Cpu.csproj" />
    <ProjectReference Include="..\RigControl.Presence\RigControl.Presence.csproj" />
    <!-- Finds other programs and Windows settings that get in RigControl's way (it only looks and explains). -->
    <ProjectReference Include="..\RigControl.Health\RigControl.Health.csproj" />
    <!-- OpenRGB, the PawnIO setup and the Equalizer APO setup, carried inside the exe (third_party/BUNDLED.md). -->
    <ProjectReference Include="..\RigControl.Bundled\RigControl.Bundled.csproj" />
    <!-- Auto-update, GitHub sign-in, reviews and dev mode's checks (only ever connects to GitHub). -->
    <ProjectReference Include="..\RigControl.Updates\RigControl.Updates.csproj" />
    <!-- RigControl Link: phones see this PC and use a few controls through the relay (only outgoing connections). -->
    <ProjectReference Include="..\RigControl.Link\RigControl.Link.csproj" />
    <ProjectReference Include="..\RigControl.iPhone\RigControl.iPhone.csproj" />
    <!-- The merged Audio Controller (soundboard, virtual mic, EQ, "also play on"), hosted as the Audio section. -->
    <ProjectReference Include="..\Audio\AudioController.App\AudioController.App.csproj" />
  </ItemGroup>


  <ItemGroup>
    <InternalsVisibleTo Include="RigControl.App.Tests" />
  </ItemGroup>

  <!-- The licences, notices and terms travel inside the exe: the installer writes them to <install>\licenses and
       Settings shows them (Install\LicenceFiles.cs). -->
  <ItemGroup>
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)..\..\LICENSE;$(MSBuildThisFileDirectory)..\..\THIRD-PARTY-NOTICES.md;$(MSBuildThisFileDirectory)..\..\TERMS-OF-USE.md;$(MSBuildThisFileDirectory)..\..\PRIVACY.md;$(MSBuildThisFileDirectory)..\..\SECURITY.md;$(MSBuildThisFileDirectory)..\..\README.md"
                      LogicalName="licenses/%(Filename)%(Extension)" Visible="false" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)..\..\LICENSES\*" LogicalName="licenses/LICENSES/%(Filename)%(Extension)" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <!-- The pairing QR code on Settings > Phone (MIT). -->
    <PackageReference Include="QRCoder" Version="1.9.0" />
  </ItemGroup>

</Project>
