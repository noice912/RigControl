<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>RigControl.Lighting</RootNamespace>
    <!--
      Two flavours (docs/PORTING.md). The Windows one (capture cards are a WinRT API) is what the Windows app uses and
      compiles every file. The neutral one, for Linux and macOS, leaves out what only Windows has: the files removed
      below, and the parts of other files inside "#if WINDOWS".
    -->
    <TargetFramework Condition="'$(TargetFramework)' == '$(RigWindowsDefaultTfm)'"></TargetFramework>
    <TargetFrameworks>$(RigDualTfms)</TargetFrameworks>
  </PropertyGroup>

  <!-- Windows only: reading OBS's picture (it stands in for a capture card), and finding and starting OpenRGB. -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'windows'">
    <Compile Remove="ObsSource.cs" />
    <Compile Remove="OpenRgbServer.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RigControl.Core\RigControl.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RigControl.Lighting.Tests" />
  </ItemGroup>

  <!-- The sound meter (WASAPI loopback) is Windows only. Secrets go through RigControl.Core, which carries what it needs. -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>
</Project>