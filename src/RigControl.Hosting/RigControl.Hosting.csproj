<Project Sdk="Microsoft.NET.Sdk">

  <!--
    What every RigControl host shares and what needs no window toolkit: the built web UI (carried inside this dll),
    the message bridge between the UI and the modules, the list of modules per system, where settings and logs live.
    Hosts: RigControl.App (Windows, WPF + WebView2) and RigControl.Desktop (Linux and macOS). See docs/PORTING.md.
  -->
  <PropertyGroup>
    <TargetFramework>$(RigPortableTfm)</TargetFramework>
    <RootNamespace>RigControl.Hosting</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RigControl.Core\RigControl.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RigControl.Hosting.Tests" />
  </ItemGroup>

  <!-- Builds src/ui with npm when it is out of date and puts the result inside this dll (resources named "ui/..."). -->
  <Import Project="WebUi.targets" />

</Project>
