<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Both flavours, like RigControl.Presence itself: each one tests the flavour it gets. -->
    <TargetFramework Condition="'$(TargetFramework)' == '$(RigWindowsDefaultTfm)'"></TargetFramework>
    <TargetFrameworks>$(RigDualTfms)</TargetFrameworks>
  </PropertyGroup>

  <!--
    The tests that were here first use Windows-only parts (pipes, sessions, the extension link) and run against the
    Windows flavour. The tests under Portable run in both flavours, and on Linux and macOS.
  -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'windows'">
    <Compile Remove="AppIdsTests.cs" />
    <Compile Remove="LimiterTests.cs" />
    <Compile Remove="MultiUserTests.cs" />
    <Compile Remove="PresenceTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/RigControl.Presence/RigControl.Presence.csproj" />
    <ProjectReference Include="../../src/RigControl.Core/RigControl.Core.csproj" />
  </ItemGroup>

  <!--
    The build step that encrypts the Discord application ids (DiscordIds.targets) is run here on a file of made-up
    ids, and the result goes into this test dll. A test then opens it with the app's own code, so the two halves of
    the recipe can never drift apart. The real ids are never put into the test dll (DiscordIdsEmbed is false).
  -->
  <PropertyGroup>
    <DiscordIdsEmbed>false</DiscordIdsEmbed>
  </PropertyGroup>
  <Import Project="../../src/RigControl.Presence/DiscordIds.targets" />
  <Target Name="SealMadeUpIds" BeforeTargets="BeforeBuild"
          Inputs="$(MSBuildProjectDirectory)/made-up-discord-ids.json;$(MSBuildThisFileDirectory)../../src/RigControl.Presence/DiscordIds.targets"
          Outputs="$(IntermediateOutputPath)made-up-ids.bin">
    <SealDiscordIds Source="$(MSBuildProjectDirectory)/made-up-discord-ids.json" Output="$(IntermediateOutputPath)made-up-ids.bin" />
  </Target>
  <Target Name="EmbedMadeUpIds" BeforeTargets="BeforeBuild" DependsOnTargets="SealMadeUpIds">
    <ItemGroup>
      <EmbeddedResource Include="$(IntermediateOutputPath)made-up-ids.bin" LogicalName="RigControl.Presence.Tests.MadeUpIds" Type="Non-Resx" WithCulture="false" />
      <EmbeddedResource Include="made-up-discord-ids.json" LogicalName="RigControl.Presence.Tests.MadeUpIds.json" />
      <FileWrites Include="$(IntermediateOutputPath)made-up-ids.bin" />
    </ItemGroup>
  </Target>

</Project>
