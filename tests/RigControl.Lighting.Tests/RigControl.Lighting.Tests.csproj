<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Both flavours of RigControl.Lighting are tested: the Windows one as before, and the neutral one (Linux, macOS). -->
    <TargetFramework Condition="'$(TargetFramework)' == '$(RigWindowsDefaultTfm)'"></TargetFramework>
    <TargetFrameworks>$(RigDualTfms)</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Tests of what only the Windows flavour has. Inside shared test files the same is done with "#if WINDOWS". -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'windows'">
    <Compile Remove="OpenRgbServerTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RigControl.Lighting\RigControl.Lighting.csproj" />
    <ProjectReference Include="..\..\src\RigControl.Core\RigControl.Core.csproj" />
  </ItemGroup>

</Project>