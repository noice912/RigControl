<?xml version="1.0" encoding="UTF-8" ?>
<!-- The PC app's palette (src/ui/src/styles.css): dark slate with a coolant-cyan accent. Dark only. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Color x:Key="Bg">#161C23</Color>
    <Color x:Key="Rail">#11161C</Color>
    <Color x:Key="Panel">#1C242D</Color>
    <Color x:Key="Raised">#242E39</Color>
    <Color x:Key="Line">#2E3A47</Color>
    <Color x:Key="LineStrong">#3D4B5A</Color>
    <Color x:Key="Text">#E4E9EE</Color>
    <Color x:Key="Muted">#95A3B2</Color>
    <Color x:Key="Faint">#66737F</Color>
    <Color x:Key="Accent">#5CC6E8</Color>
    <Color x:Key="AccentStrong">#8AD8F1</Color>
    <Color x:Key="AccentInk">#0E2B36</Color>
    <Color x:Key="Warm">#F0B44C</Color>
    <Color x:Key="Hot">#EE5A42</Color>
    <Color x:Key="Ok">#73CF98</Color>

    <!-- The template's names, kept so platform defaults (and MAUI itself) find them. -->
    <Color x:Key="Primary">#5CC6E8</Color>
    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
</ResourceDictionary>
