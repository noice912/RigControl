<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="RigControl.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:RigControl.Mobile.Views"
    Title="RigControl"
    FlyoutBehavior="Disabled">

    <TabBar>
        <ShellContent
            Title="PCs"
            Icon="tab_pcs.png"
            ContentTemplate="{DataTemplate views:PcsPage}"
            Route="pcs" />
        <ShellContent
            Title="Settings"
            Icon="tab_settings.png"
            ContentTemplate="{DataTemplate views:SettingsPage}"
            Route="settings" />
    </TabBar>

</Shell>
