<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:RigControl.Mobile.Views"
             x:Class="RigControl.Mobile.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <views:NotEmptyConverter x:Key="NotEmpty" />
            <views:OnlineBrushConverter x:Key="OnlineBrush" />
            <views:ErrorColorConverter x:Key="ErrorColor" />
            <views:InvertConverter x:Key="Invert" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
