<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RigControl.Mobile.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:RigControl.Mobile.ViewModels"
    x:DataType="vm:SettingsViewModel"
    Title="Settings">

    <ScrollView>
        <VerticalStackLayout Padding="16,12,16,32" Spacing="14">

            <!-- This phone -->
            <Label Text="This phone" Style="{StaticResource Section}" />
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Name shown on your PCs" />
                    <Entry Text="{Binding PhoneName}" MaxLength="40" />
                    <Label Text="Your PCs list this phone by this name, so you can tell your phones apart and remove one."
                           Style="{StaticResource Muted}" />
                </VerticalStackLayout>
            </Border>

            <!-- Link -->
            <Label Text="Link to your PCs" Style="{StaticResource Section}" />
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding LinkMode}" />
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Label Text="Relay" Style="{StaticResource Muted}" />
                        <Label Grid.Column="1" Text="{Binding Relay}" HorizontalTextAlignment="End" LineBreakMode="MiddleTruncation" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Music on Discord: the phone feeds the PC, the PC posts the card. -->
            <Label Text="Music on Discord" Style="{StaticResource Section}" />
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Your PC shows the song you're listening to on your Discord status. It needs the PC on, with RigControl and Discord running." />

                    <!-- Spotify -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Label Text="Spotify" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding SpotifyStatus}" Style="{StaticResource Muted}"
                               HorizontalTextAlignment="End" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                    </Grid>
                    <Label Style="{StaticResource Muted}"
                           Text="Works even when the phone is locked: the PC asks Spotify what you're playing on any device. You sign in on Spotify's own page; only a read-only sign-in goes to your PCs, and this phone keeps none of it." />
                    <Button Text="Connect Spotify" Command="{Binding ConnectSpotifyCommand}" IsVisible="{Binding SpotifyNotConnected}" />
                    <Button Text="Disconnect Spotify" Style="{StaticResource Secondary}" Command="{Binding DisconnectSpotifyCommand}"
                            IsVisible="{Binding SpotifyConnected}" />
                    <Label Text="{Binding SpotifyMessage}" Style="{StaticResource Muted}" IsVisible="{Binding SpotifyMessage, Converter={StaticResource NotEmpty}}" />

                    <!-- iPhone Music app -->
                    <VerticalStackLayout Spacing="10" IsVisible="{Binding ShowAppleMusic}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,6,0,0">
                            <Label Text="Share my iPhone's Music app song" VerticalOptions="Center" />
                            <Switch Grid.Column="1" IsToggled="{Binding ShareAppleMusic}" />
                        </Grid>
                        <Label Style="{StaticResource Muted}"
                               Text="Only while RigControl is open on this iPhone: the song is sent to your linked PCs every few seconds, and cleared when you leave the app." />
                        <Label Text="{Binding MusicMessage}" Style="{StaticResource Muted}" IsVisible="{Binding MusicMessage, Converter={StaticResource NotEmpty}}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- About -->
            <Label Text="About" Style="{StaticResource Section}" />
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="RigControl Mobile" />
                        <Label Grid.Column="1" Text="{Binding Version}" Style="{StaticResource Muted}" />
                    </Grid>
                    <Label Style="{StaticResource Muted}"
                           Text="Free software under the GNU GPL version 3. Uses .NET MAUI (MIT), CommunityToolkit.Mvvm (MIT) and ZXing.Net.MAUI (MIT) with ZXing.Net (Apache 2.0)." />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
