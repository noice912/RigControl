<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 and later: nothing of this app (the linked PCs, and the files the protected keys are kept in) goes to a
  cloud backup or to a new phone through device-to-device transfer. The keys stay on this phone; a new phone links
  the PC again. (allowBackup=false already covers adb and older Androids.)
-->
<data-extraction-rules>
	<cloud-backup>
		<exclude domain="root" path="." />
		<exclude domain="file" path="." />
		<exclude domain="database" path="." />
		<exclude domain="sharedpref" path="." />
		<exclude domain="external" path="." />
		<exclude domain="device_root" path="." />
		<exclude domain="device_file" path="." />
		<exclude domain="device_database" path="." />
		<exclude domain="device_sharedpref" path="." />
	</cloud-backup>
	<device-transfer>
		<exclude domain="root" path="." />
		<exclude domain="file" path="." />
		<exclude domain="database" path="." />
		<exclude domain="sharedpref" path="." />
		<exclude domain="external" path="." />
		<exclude domain="device_root" path="." />
		<exclude domain="device_file" path="." />
		<exclude domain="device_database" path="." />
		<exclude domain="device_sharedpref" path="." />
	</device-transfer>
</data-extraction-rules>
